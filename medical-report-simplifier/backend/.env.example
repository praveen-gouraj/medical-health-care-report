# ==============================================================================
# 🏥 MEDICAL REPORT SIMPLIFIER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 🤖 AI/ML API KEYS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyBIqKQ2CSuZrLq3B5nQ1vnU_7tPI1EssFA
OPENAI_API_KEY=your_openai_api_key_here_for_backup
ANTHROPIC_API_KEY=your_claude_api_key_here_for_backup
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# 🌐 FLASK CONFIGURATION
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_SECRET_KEY=your_super_secret_key_here_change_in_production
FLASK_PORT=5000
FLASK_HOST=127.0.0.1

# 🗄️ DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///medical_reports.db
POSTGRES_URL=postgresql://user:password@localhost:5432/medical_db
MONGODB_URI=mongodb://localhost:27017/medical_reports
REDIS_URL=redis://localhost:6379/0

# 📧 EMAIL SERVICES (for reports & notifications)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAILGUN_API_KEY=your_mailgun_api_key_here

# ☁️ CLOUD STORAGE (for file uploads & processing)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=medical-reports-bucket
AWS_REGION=us-east-1
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_STORAGE_BUCKET=medical-reports-gcs
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string

# 🔍 OCR & DOCUMENT PROCESSING
# ------------------------------------------------------------------------------
GOOGLE_VISION_API_KEY=your_google_vision_api_key
AZURE_COMPUTER_VISION_KEY=your_azure_cv_key
AZURE_COMPUTER_VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
TEXTRACT_ACCESS_KEY=your_aws_textract_key
TEXTRACT_SECRET_KEY=your_aws_textract_secret

# 📊 ANALYTICS & MONITORING
# ------------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=GA4-MEASUREMENT-ID
MIXPANEL_TOKEN=your_mixpanel_token
SENTRY_DSN=your_sentry_dsn_for_error_tracking
NEW_RELIC_LICENSE_KEY=your_newrelic_key
DATADOG_API_KEY=your_datadog_api_key

# 🔐 SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_here
OAUTH_GOOGLE_CLIENT_ID=your_google_oauth_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_oauth_secret
OAUTH_GITHUB_CLIENT_ID=your_github_oauth_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_oauth_secret
ENCRYPTION_KEY=your_encryption_key_for_sensitive_data
RATE_LIMIT_PER_MINUTE=100

# 🌍 INTERNATIONALIZATION
# ------------------------------------------------------------------------------
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,hi,zh,ja,ar
TRANSLATION_API_KEY=your_google_translate_api_key
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC

# 🏥 MEDICAL DATA APIS
# ------------------------------------------------------------------------------
FHIR_SERVER_URL=https://your-fhir-server.com
SNOMED_API_KEY=your_snomed_api_key
ICD10_API_KEY=your_icd10_api_key
DRUG_INTERACTION_API_KEY=your_drug_api_key
MEDICAL_REFERENCE_API_KEY=your_medical_ref_api_key

# 📱 MOBILE & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
PUSH_NOTIFICATION_KEY=your_push_notification_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# 🔄 INTEGRATION APIS
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=your_slack_bot_token
DISCORD_WEBHOOK_URL=your_discord_webhook_url
TEAMS_WEBHOOK_URL=your_teams_webhook_url
ZAPIER_WEBHOOK_URL=your_zapier_webhook_url

# ⚡ PERFORMANCE & CACHING
# ------------------------------------------------------------------------------
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TIMEOUT=300
MAX_CONTENT_LENGTH=16777216
MAX_FILE_SIZE=50MB
ALLOWED_EXTENSIONS=pdf,txt,doc,docx,jpg,jpeg,png

# 🌟 FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_AI_ANALYSIS=True
ENABLE_OCR_PROCESSING=True
ENABLE_EMAIL_REPORTS=True
ENABLE_MULTI_LANGUAGE=True
ENABLE_PUSH_NOTIFICATIONS=True
ENABLE_SOCIAL_LOGIN=True
ENABLE_ANALYTICS=True
ENABLE_RATE_LIMITING=True
ENABLE_FILE_ENCRYPTION=True
ENABLE_AUDIT_LOGGING=True

# 🎯 SDG & IMPACT TRACKING
# ------------------------------------------------------------------------------
UN_SDG_REPORTING_ENDPOINT=https://your-sdg-tracking-endpoint.com
IMPACT_METRICS_API_KEY=your_impact_metrics_api_key
GLOBAL_HEALTH_DATA_API=your_global_health_api_key

# 🔧 DEVELOPMENT & TESTING
# ------------------------------------------------------------------------------
TESTING_MODE=False
MOCK_AI_RESPONSES=False
DEBUG_SQL_QUERIES=False
LOG_LEVEL=INFO
LOG_FILE=logs/medical_app.log
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com